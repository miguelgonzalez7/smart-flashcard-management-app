package org.example.csia;

import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Node;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.image.Image;
import javafx.scene.image.ImageView;
import javafx.scene.input.Clipboard;
import javafx.scene.layout.StackPane;
import javafx.stage.Stage;
import java.io.IOException;
import java.util.Optional;

public class FlashcardEditor {
    @FXML private ChoiceBox<String> subject;
    @FXML private ChoiceBox<String> topic;
    @FXML private TextArea frontText;
    @FXML private TextArea backText;
    @FXML private StackPane frontPane;
    @FXML private ImageView frontImageView;
    @FXML private StackPane backPane;
    @FXML private ImageView backImageView;
    @FXML private Button frontImagePaste;
    @FXML private Button backImagePaste;
    @FXML private Button undoFrontPaste;
    @FXML private Button undoBackPaste;
    @FXML private ToggleGroup difficulty;
    @FXML private RadioButton easy;
    @FXML private RadioButton medium;
    @FXML private RadioButton hard;

    private Flashcard flashcardToEdit;
    private final FlashcardDeck flashcardDeck = FlashcardDeck.getInstance();

    public void initialize() {
        flashcardDeck.loadCategories();
        subject.getItems().addAll(flashcardDeck.getSubjects());
        subject.getItems().add("Create New...");
        subject.setOnAction(event -> updateSubjectAndTopic());
        topic.setOnAction(event -> {
            if ("Create New...".equals(topic.getValue())) {
                handleCreateNewOption(topic);
            }
        });
    }

    public void paste(ActionEvent event) {
        Image image = Clipboard.getSystemClipboard().getImage();
        if (image == null) {
            new AlertMaker(Alert.AlertType.ERROR, "No Image", "No image found.", "Please copy an image to your clipboard.");
            return;
        }

        Button sourceButton = (Button) event.getSource();
        StackPane targetPane;
        ImageView targetImageView;
        TextArea targetTextArea;

        if (sourceButton == frontImagePaste) {
            targetPane = frontPane;
            targetImageView = frontImageView;
            targetTextArea = frontText;
            frontImagePaste.setVisible(false);
            undoFrontPaste.setVisible(true);
        } else if (sourceButton == backImagePaste) {
            targetPane = backPane;
            targetImageView = backImageView;
            targetTextArea = backText;
            backImagePaste.setVisible(false);
            undoBackPaste.setVisible(true);
        } else {
            return;
        }

        targetImageView.setImage(image);
        targetImageView.setPreserveRatio(true);
        targetPane.setVisible(true);
        targetTextArea.setVisible(false);
    }

    public void undoPaste(ActionEvent event) {
        Button sourceButton = (Button) event.getSource();
        StackPane targetPane;
        TextArea targetTextArea;

        if (sourceButton == undoFrontPaste) {
            targetPane = frontPane;
            targetTextArea = frontText;
            frontImagePaste.setVisible(true);
            undoFrontPaste.setVisible(false);
        } else {
            targetPane = backPane;
            targetTextArea = backText;
            backImagePaste.setVisible(true);
            undoBackPaste.setVisible(false);
        }

        targetTextArea.setVisible(true);
        targetPane.setVisible(false);
    }

    public void addToDeck(ActionEvent event) throws IOException {
        String selectedSubject = subject.getValue();
        String selectedTopic = topic.getValue();
        int diff = getDifficulty();
        String frontText = null;
        Image frontImage = null;
        String backText = null;
        Image backImage = null;

        if (frontIsAnImage()) {
            frontImage = frontImageView.getImage();
        } else {
            frontText = this.frontText.getText().trim();
        }

        if (backIsAnImage()) {
            backImage = backImageView.getImage();
        } else {
            backText = this.backText.getText().trim();
        }

        boolean isValid = checkIfValid(frontText, frontImage, backText, backImage, selectedSubject, selectedTopic, diff);
        if (!isValid) return;

        if (flashcardToEdit != null) {
            int index = flashcardToEdit.getIndex();
            Flashcard.deleteImages(index + 1);
            Flashcard editedFlashcard = createFlashcard(frontText, frontImage, backText, backImage, selectedSubject, selectedTopic, diff);
            editedFlashcard.setUnderstanding(flashcardToEdit.getUnderstanding());
            flashcardDeck.replace(editedFlashcard, index);
            new AlertMaker(Alert.AlertType.INFORMATION, "Flashcard Edited", null, "Changes have been saved!");
            saveImages(editedFlashcard, index, frontIsAnImage(), backIsAnImage(), frontImage, backImage);
        } else {
            Flashcard newFlashcard = createFlashcard(frontText, frontImage, backText, backImage, selectedSubject, selectedTopic, diff);
            int index = newFlashcard.getIndex();
            flashcardDeck.add(newFlashcard);
            Flashcard.incrementFlashcardCounter();
            new AlertMaker(Alert.AlertType.INFORMATION, "Flashcard Added", null, "Flashcard has been successfully added to the deck!");
            saveImages(newFlashcard, index, frontIsAnImage(), backIsAnImage(), frontImage, backImage);
        }

        flashcardDeck.saveDeck();
        goBack(event);
    }

    public void saveImages(Flashcard flashcard, int index, boolean frontIsAnImage, boolean backIsAnImage, Image frontImage, Image backImage) {
        try {
            if (frontIsAnImage) {
                flashcard.saveImageToFile(frontImage, index + 1, "front");
            }
            if (backIsAnImage) {
                flashcard.saveImageToFile(backImage, index + 1, "back");
            }
        } catch (IOException e) {
            System.out.println("Unable to save images.");
        }
    }

    private void handleCreateNewOption(ChoiceBox<String> choiceBox) {
        TextInputDialog dialog = new TextInputDialog();
        dialog.setTitle("Create New");
        dialog.setHeaderText("Enter a new " + (choiceBox == subject ? "subject" : "topic"));
        dialog.setContentText("Name");

        Optional<String> result = dialog.showAndWait();
        result.ifPresent(newEntry -> {
            choiceBox.getItems().remove("Create New...");
            choiceBox.getItems().add(newEntry);
            choiceBox.getItems().add("Create New...");
            choiceBox.setValue(newEntry);

            if (choiceBox == subject) {
                topic.getItems().clear();
                topic.getItems().add("Create New...");
                flashcardDeck.addSubject(newEntry);
            } else if (choiceBox == topic) {
                String selectedSubject = subject.getValue();
                flashcardDeck.addTopic(selectedSubject, newEntry);
            }
        });
        flashcardDeck.saveCategories();
    }

    private Flashcard createFlashcard(String frontText, Image frontImage, String backText, Image backImage, String selectedSubject, String selectedTopic, int diff) {
        if (frontImage != null && backImage != null) {
            return new Flashcard(diff, selectedSubject, selectedTopic, frontImage, backImage);
        } else if (frontImage != null) {
            return new Flashcard(diff, selectedSubject, selectedTopic, frontImage, backText);
        } else if (backImage != null) {
            return new Flashcard(diff, selectedSubject, selectedTopic, frontText, backImage);
        } else {
            return new Flashcard(diff, selectedSubject, selectedTopic, frontText, backText);
        }
    }

    public void setFlashcardData(Flashcard flashcard) {
        this.flashcardToEdit = flashcard;
        RadioButton selectedButton = getSelectedRadioButton(flashcard);
        difficulty.selectToggle(selectedButton);
        subject.setValue(flashcard.getSubject());
        topic.setValue(flashcard.getTopic());

        if (flashcard.hasTextFront()) {
            frontText.setText(flashcard.getFrontSideText());
            frontText.setVisible(true);
            frontPane.setVisible(false);
            frontImagePaste.setVisible(true);
        } else if (flashcard.hasImageFront()) {
            frontImageView.setImage(flashcard.getFrontSideImage());
            frontImageView.setPreserveRatio(true);
            frontPane.setVisible(true);
            frontText.setVisible(false);
            undoFrontPaste.setVisible(true);
        }

        if (flashcard.hasTextBack()) {
            backText.setText(flashcard.getBackSideText());
            backText.setVisible(true);
            backPane.setVisible(false);
            backImagePaste.setVisible(true);
        } else if (flashcard.hasImageBack()) {
            backImageView.setImage(flashcard.getBackSideImage());
            backImageView.setPreserveRatio(true);
            backPane.setVisible(true);
            backText.setVisible(false);
            undoBackPaste.setVisible(true);
        }
    }

    public boolean checkIfValid(String frontText, Image frontImage, String backText, Image backImage, String selectedSubject, String selectedTopic, int diff) {
        if ((((frontText == null) && (frontImage == null)) || ((backText == null) && (backImage == null))) || selectedSubject == null || selectedTopic == null || diff == 0) {
            new AlertMaker(Alert.AlertType.ERROR, "Cannot Create", null, "Unable to add flashcard. Please make sure to fill out all fields.");
            return false;
        } else {
            return true;
        }
    }

    private int getDifficulty() {
        RadioButton selectedDifficulty = (RadioButton) difficulty.getSelectedToggle();
        if (selectedDifficulty == easy) return 1;
        else if (selectedDifficulty == medium) return 2;
        else if (selectedDifficulty == hard) return 3;
        else return 0;
    }

    private RadioButton getSelectedRadioButton(Flashcard flashcard) {
        if (flashcard.getDifficulty() == 1) return easy;
        else if (flashcard.getDifficulty() == 2) return medium;
        else return hard;
    }

    private boolean frontIsAnImage() { return !frontText.isVisible(); }
    private boolean backIsAnImage() { return !backText.isVisible(); }

    public void goBack(ActionEvent event) throws IOException {
        FXMLLoader loader = new FXMLLoader(getClass().getResource("HomeScreen.fxml"));
        Parent root = loader.load();
        Stage stage = (Stage) ((Node) event.getSource()).getScene().getWindow();
        Scene scene = new Scene(root);
        stage.setScene(scene);
        stage.show();
    }

    private void updateSubjectAndTopic() {
        String selectedSubject = subject.getValue();
        if ("Create New...".equals(selectedSubject)) {
            handleCreateNewOption(subject);
        } else {
            topic.getItems().clear();
            if (selectedSubject != null) {
                List<String> topics = flashcardDeck.getTopicsForSubject(selectedSubject);
                if (!topics.isEmpty()) {
                    topic.getItems().addAll(topics);
                }
            }
            topic.getItems().add("Create New...");
            topic.setValue(null);
        }
    }
}
